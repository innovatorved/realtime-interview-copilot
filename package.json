{
  "name": "realtime-interview-copilot",
  "version": "0.9.0-beta",
  "private": true,
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "next build && next export",
    "start": "next start",
    "lint": "eslint .",
    "fix": "bunx @biomejs/biome format --write .",
    "build:electron": "node scripts/build-electron.js",
    "electron:dev": "bun run build:electron && concurrently \"PORT=3000 bun run dev\" \"wait-on http://localhost:3000 && DEV_PORT=3000 electron .\"",
    "electron:debug": "ELECTRON_DEBUG=true bun run build:electron && concurrently \"PORT=3000 bun run dev\" \"wait-on http://localhost:3000 && DEV_PORT=3000 electron .\"",
    "electron:build": "rm -f electron/DEBUG_BUILD && bun run build:electron && bun run build && electron-builder",
    "electron:build:debug": "bun run build:electron && bun run build && printf 'debug build · %s\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" > electron/DEBUG_BUILD && electron-builder",
    "electron:start": "bun run build:electron && electron .",
    "clean": "rm -rf .next out dist electron/*.js electron/*.js.map electron/DEBUG_BUILD"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.3",
    "@next/third-parties": "^16.2.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@uidotdev/usehooks": "^2.4.1",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "next": "^16.2.6",
    "posthog-js": "^1.374.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.31",
    "concurrently": "^8.2.2",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "wait-on": "^7.2.0",
    "wrangler": "^4.93.0"
  },
  "main": "electron/main.js",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "@biomejs/biome",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "core-js",
    "unrs-resolver",
    "protobufjs",
    "workerd"
  ],
  "build": {
    "appId": "com.realtime.interview.copilot.beta",
    "productName": "Realtime Interview Copilot Beta",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/icons/android-chrome-512x512.png",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "minimumSystemVersion": "11.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Realtime Interview Copilot uses the microphone to transcribe your voice for the Ask AI feature.",
        "NSCameraUsageDescription": "Realtime Interview Copilot does not record from the camera; this permission is requested only by macOS for media capture APIs and will not be used.",
        "NSAppleEventsUsageDescription": "Realtime Interview Copilot does not script other apps; this permission is requested only by macOS for system integration.",
        "LSUIElement": false,
        "NSHighResolutionCapable": true
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "public/icons/favicon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "public/icons/android-chrome-512x512.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
